# ==============================================================================
# CANDELA TILES & MARBLES — FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local runtime or configure in hosting provider (e.g. Vercel).
# NEVER commit production credentials, passwords, or connection secrets to Git.
# ==============================================================================

# Backend API Service URL (Spring Boot Modular Monolith)
# Local: http://localhost:8080 | Production: https://[your-backend-app].onrender.com
BACKEND_URL=

# Public Application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Concierge & Contact Configuration
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONCIERGE_PHONE=
NEXT_PUBLIC_CONCIERGE_EMAIL=

# Object Storage Configuration (Supabase Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=candela-media

# Optional Server-Side Direct Database Access (Legacy/Migration only)
DATABASE_URL=
